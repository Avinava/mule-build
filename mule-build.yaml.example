# Example mule-build configuration
# Copy this file to mule-build.yaml in your project root

# Project settings
project:
  # Optional: Override project name (defaults to pom.xml <name> or <artifactId>)
  # name: "my-mule-api"

# Named build profiles. The built-in production defaults may be overridden here.

profiles:
  # Production profile for CI/CD
  production:
    description: 'CI/CD Artifacts'
    mavenProfile: 'prod' # Maps to <id>prod</id> in pom.xml
    secureProperties: 'enforce' # Fail on secrets and unsecured references before building
    includeSource: false # Do not include source code
    enforceGitClean: true # Require clean git tree
    compatibility: 'enforce' # Fail when packaged connectors disagree with the target (enforce | warn | off)

  # Custom profile example for staging
  # staging:
  #   description: "Staging Environment"
  #   mavenProfile: "staging"
  #   secureProperties: "enforce"
  #   includeSource: false

# Local Mule runtime discovery and compatibility policy
runtime:
  # Explicit runtime home (MULE_HOME and --runtime-home take precedence)
  # home: "/opt/mule-enterprise-standalone-4.10.2"
  searchPaths:
    - '~/muleRuntimes'
  # Reject fallbacks that do not match the runtime declared by .classpath
  strictVersion: true

# Deployment target for compatibility checks. Defaults: pom.xml <app.runtime> and
# mule-artifact.json javaSpecificationVersions.
# target:
#   muleVersion: '4.6.6'
#   javaVersion: '17'

# Security gate settings
# security:
#   sensitiveKeys: ['vendorPin'] # Extra key endings treated as secrets
#   allow: # Reviewed exceptions; reason is required
#     - file: 'src/main/resources/sample.yaml'
#       key: 'sample.demo.password'
#       reason: 'Public demo value'
